# API keys are only needed when the matching hosted provider is selected.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Identification and classification of subjects
OVS_LLM_PROVIDER=ollama
OVS_LLM_MODEL=gemma2
OVS_LLM_REASONING_EFFORT=
# Leave blank to use the selected provider's default endpoint.
OVS_LLM_BASE_URL=
OVS_LLM_TIMEOUT_SECONDS=120

# Independent evaluator for opt-in transcript information analysis.
# Provider selects the API service; Jev is the TypeSafe model.
OVS_INFORMATION_MAX_CALLS=1000
OVS_INFORMATION_CONCURRENCY=2
OVS_EVALUATOR_PROVIDER=typesafe
OVS_EVALUATOR_MODEL=jev-1.13.0
OVS_EVALUATOR_API_KEY=
# Leave blank to use the selected evaluator provider's default endpoint.
OVS_EVALUATOR_BASE_URL=
OVS_EVALUATOR_TIMEOUT_SECONDS=30
OVS_EVALUATOR_MAX_ATTEMPTS=2

# Transcription
OVS_STT_PROVIDER=whisper_local
OVS_STT_MODEL=base
OVS_STT_LANGUAGE=pt
OVS_STT_TIMEOUT_SECONDS=120

# Retry budget for generator and transcription requests.
OVS_MAX_ATTEMPTS=3

# CPU thread budget for local processing.
OVS_THREADS=2

# Visual features: segment interval (default) or legacy full source video.
OVS_VISUAL_SCOPE=segment
