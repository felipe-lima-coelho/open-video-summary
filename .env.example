# API keys are only needed when the matching hosted provider is selected.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Identification and classification of subjects
OVS_LLM_PROVIDER=ollama
OVS_LLM_MODEL=gemma2
OVS_LLM_REASONING_EFFORT=
# Leave blank to use the selected provider's default endpoint.
OVS_LLM_BASE_URL=
OVS_LLM_TIMEOUT_SECONDS=120
# Total deadline includes admission waits and all attempts. A 429 pause does not
# make a slow individual generation finish within its per-attempt timeout.
OVS_LLM_OPERATION_TIMEOUT_SECONDS=360
# Responses output ceiling includes visible output and reasoning tokens.
OVS_LLM_MAX_OUTPUT_TOKENS=16384
# Optional preventive ceilings per window; blank learns OpenAI response limits.
# Header discovery uses 90% of published request/token limits with a 60s window.
OVS_LLM_REQUEST_LIMIT=
OVS_LLM_TOKEN_LIMIT=
OVS_LLM_RATE_WINDOW_SECONDS=60
OVS_LLM_LEARN_RATE_LIMITS=true
# Sent to OpenAI and included in the process-local controller's scope.
OVS_LLM_ORGANIZATION=
OVS_LLM_PROJECT=
# Set the same group for models sharing a provider limit family; blank=model.
OVS_LLM_LIMIT_GROUP=

# Independent evaluator for opt-in transcript information analysis.
# Provider selects the API service; Jev is the TypeSafe model.
OVS_INFORMATION_MAX_CALLS=1000
OVS_INFORMATION_CONCURRENCY=2
# Paid individual comparisons in flight; source target concurrency is separate.
OVS_INFORMATION_PAIR_CONCURRENCY=8
# Auto uses remaining global logical calls. A number is an additional paid cap;
# 0 disables paid comparisons. Free exact validated proofs never consume it.
OVS_INFORMATION_MAX_PAIRS=auto
OVS_EVALUATOR_PROVIDER=typesafe
OVS_EVALUATOR_MODEL=jev-1.13.0
OVS_EVALUATOR_API_KEY=
# Leave blank to use the selected evaluator provider's default endpoint.
OVS_EVALUATOR_BASE_URL=
OVS_EVALUATOR_TIMEOUT_SECONDS=30
OVS_EVALUATOR_MAX_ATTEMPTS=2
OVS_EVALUATOR_OPERATION_TIMEOUT_SECONDS=90
# Conservative starting limits for an 80 req/s, 100000 input-token/s Jev org.
# Reservations estimate the complete payload (including all questions/state).
OVS_EVALUATOR_REQUEST_LIMIT=60
OVS_EVALUATOR_TOKEN_LIMIT=80000
OVS_EVALUATOR_RATE_WINDOW_SECONDS=1
OVS_EVALUATOR_LIMIT_GROUP=

# Transcription
OVS_STT_PROVIDER=whisper_local
OVS_STT_MODEL=base
OVS_STT_LANGUAGE=pt
OVS_STT_TIMEOUT_SECONDS=120

# Retry budget for generator and transcription requests.
OVS_MAX_ATTEMPTS=3

# CPU thread budget for local processing.
OVS_THREADS=2

# Visual features: segment interval (default) or legacy full source video.
OVS_VISUAL_SCOPE=segment
